{
  "name": "ryukijano-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "smoke": "esbuild ssr-smoke.jsx --bundle --platform=node --format=cjs --jsx=automatic --loader:.js=jsx --outfile=node_modules/.cache/ssr-smoke.cjs --log-level=error && node node_modules/.cache/ssr-smoke.cjs",
    "facts": "esbuild fact-check.jsx --bundle --platform=node --format=cjs --jsx=automatic --loader:.js=jsx --outfile=node_modules/.cache/fact-check.cjs --log-level=error && node node_modules/.cache/fact-check.cjs",
    "notes": "node tools/check-notes.mjs",
    "tokens": "node tools/patch-mcu.mjs && node tools/gen-m3-tokens.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "autoprefixer": "^10.4.22",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.1.17",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@material/material-color-utilities": "^0.4.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  },
  "description": "Portfolio of Gyanateet Dutta — graphics, surgical vision, and quantum algorithms."
}
